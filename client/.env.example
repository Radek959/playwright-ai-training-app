# Zmienia data-testid i id elementów (symulacja refactoringu)
VITE_REFACTOR_SELECTORS=false

# Zmienia layout z listy na grid + dodaje dropdown akcji
VITE_REFACTOR_LAYOUT=false

# Zmienia nazwy pól API (title→name, description→content)
VITE_API_VERSION_2=false

# RWD Testing Flags
# Przenosi przycisk "Add Task" na mobile jako FAB (Floating Action Button)
VITE_MOBILE_BREAKING_CHANGE=false

# Ukrywa niektóre elementy na mobile (kolumny tabeli, metadata)
VITE_HIDDEN_ON_MOBILE=false
