{
  "openapi": "3.0.1",
  "info": {
    "title": "AI Training Sandbox API",
    "version": "0.3.0"
  },
  "servers": [
    { "url": "http://localhost:3001" }
  ],
  "paths": {
    "/api/tasks": {
      "get": {
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create task",
        "description": "Creating a task with status 'done' requires every id in 'dependencies' to already reference a task whose status is 'done'; otherwise the request is rejected with 409 (see TaskCompletionBlockedResponse) and no task is created.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskCreateInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } }
            }
          },
          "409": {
            "description": "status is 'done' but at least one direct dependency is not yet 'done'",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TaskCompletionBlockedResponse" } }
            }
          }
        }
      }
    },
    "/api/tasks/search": {
      "get": {
        "summary": "Search tasks by title or description",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search query. Fewer than 2 characters returns an empty array.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching tasks (max 10)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "summary": "Get a single task",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Task", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update task",
        "description": "id is not an updatable field and any attempt to set it (or any other field outside TaskUpdateInput) returns 400. Whenever the resulting task (existing fields merged with the patch) has status 'done' — whether status is changing to 'done' now or the task was already 'done' and only 'dependencies' changed — every id in the resulting 'dependencies' must reference a task whose status is 'done'; otherwise the request is rejected with 409 (see TaskCompletionBlockedResponse) and the task is left completely unchanged.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TaskUpdateInput" } }
          }
        },
        "responses": {
          "200": { "description": "Updated task", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } }
            }
          },
          "404": { "description": "Not found" },
          "409": {
            "description": "Resulting status is 'done' but at least one direct dependency is not yet 'done'",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TaskCompletionBlockedResponse" } }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete task",
        "description": "Deleting a task removes its ID from the dependencies of all remaining tasks.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "List users",
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ok"] } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "delete": {
        "summary": "Delete user",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Deleted. assigneeId is cleared from all remaining tasks assigned to this user." },
          "404": { "description": "Not found" },
          "409": { "description": "User has active (non-done) tasks assigned and cannot be deleted" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "dueDate": { "type": "string", "nullable": true, "description": "ISO 8601 date or date-time, e.g. '2024-01-01' or '2024-01-01T00:00:00.000Z'." },
          "completedAt": { "type": "string", "format": "date-time", "description": "Set automatically when status becomes done unless provided explicitly; cleared when status is not done." },
          "assigneeId": { "type": "string", "nullable": true },
          "coverImage": { "type": "string", "nullable": true },
          "taskType": { "type": "string", "enum": ["bug", "feature", "research"], "nullable": true },
          "estimatedHours": { "type": "number", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" }, "description": "IDs of other tasks this task depends on. A task cannot have status 'done' while any of these directly referenced tasks is not itself 'done'." },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"], "nullable": true, "description": "Required when taskType is bug." },
          "requiresApproval": { "type": "boolean" },
          "approver": { "type": "string", "nullable": true, "description": "Required when requiresApproval is true." }
        },
        "required": ["id", "title", "status", "priority"]
      },
      "TaskCreateInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "dueDate": { "type": "string", "description": "Any value parseable as a JavaScript Date, e.g. an ISO 8601 date ('2024-01-01') or date-time ('2024-01-01T00:00:00.000Z')." },
          "completedAt": { "type": "string", "format": "date-time", "description": "Optional. Only honored when status is 'done'; null is rejected." },
          "assigneeId": { "type": "string", "description": "Must reference an existing user. Optional (Quick Add can omit it)." },
          "taskType": { "type": "string", "enum": ["bug", "feature", "research"] },
          "estimatedHours": { "type": "number", "minimum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" }, "description": "Must reference existing task IDs. If status is 'done', every referenced task must already be 'done' (see TaskCompletionBlockedResponse)." },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "requiresApproval": { "type": "boolean" },
          "approver": { "type": "string" }
        },
        "required": ["title"],
        "description": "Business rules: bug requires severity; research requires estimatedHours >= 1; high priority tasks with estimatedHours cannot exceed 24; requiresApproval=true requires approver; status 'done' requires every direct dependency to already be 'done'."
      },
      "TaskUpdateInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "nullable": true, "description": "Pass null to clear." },
          "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "dueDate": { "type": "string", "nullable": true, "description": "Any value parseable as a JavaScript Date, e.g. an ISO 8601 date ('2024-01-01') or date-time ('2024-01-01T00:00:00.000Z'). Pass null to clear." },
          "completedAt": { "type": "string", "format": "date-time", "description": "Derived from status; null is rejected. To clear it, set status away from 'done' instead." },
          "assigneeId": { "type": "string", "nullable": true, "description": "Pass null to unassign." },
          "taskType": { "type": "string", "enum": ["bug", "feature", "research"], "nullable": true, "description": "Pass null to clear." },
          "estimatedHours": { "type": "number", "minimum": 1, "nullable": true, "description": "Pass null to clear." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Send [] to clear; null is not accepted for array fields." },
          "dependencies": { "type": "array", "items": { "type": "string" }, "description": "Send [] to clear; null is not accepted for array fields. If the resulting task's status is 'done', every referenced task must already be 'done' (see TaskCompletionBlockedResponse)." },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"], "nullable": true, "description": "Pass null to clear." },
          "requiresApproval": { "type": "boolean" },
          "approver": { "type": "string", "nullable": true, "description": "Pass null to clear." }
        },
        "additionalProperties": false,
        "description": "Partial update. Only these fields may be sent; any other field (including id) is rejected with 400. Fields marked nullable accept null to clear the stored value (required fields such as title/status/priority do not accept null). Fields are merged with the existing task before the same business rules as TaskCreateInput are re-validated, including: if the resulting status is 'done', every direct dependency must already be 'done'."
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      },
      "TaskCompletionBlockedResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "enum": ["Cannot complete task with incomplete dependencies"] },
          "blockingDependencies": {
            "type": "array",
            "description": "Only the direct dependencies (from 'dependencies') whose status is not 'done'; dependencies that are already 'done' are omitted.",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "status": { "type": "string", "enum": ["todo", "in-progress"] }
              },
              "required": ["id", "title", "status"]
            }
          }
        },
        "required": ["error", "blockingDependencies"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
          "avatar": { "type": "string", "nullable": true },
          "avatarUrl": { "type": "string", "nullable": true }
        },
        "required": ["id", "name", "email", "role"]
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
          "avatar": { "type": "string" }
        },
        "required": ["name", "email"],
        "description": "email must be unique and a valid email address; role must be one of the listed values (an invalid role is rejected, never silently downgraded)."
      }
    }
  }
}
